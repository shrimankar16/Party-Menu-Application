# Party Menu Application - Environment Variables Example
# Copy this file to .env for local development

# API Configuration
VITE_AUTH_API_URL=https://serverless-api-teal.vercel.app/api/auth/signin

# LocalStorage Keys (optional - defaults are used if not set)
VITE_TOKEN_KEY=party_menu_token
VITE_USER_KEY=party_menu_user
VITE_SAVED_RECIPES_KEY=party_menu_saved_recipes
